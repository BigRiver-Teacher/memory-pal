# ============================================================
# 忆伴 (memory-pal) 环境变量示例
# ============================================================
#
# 本项目有两种配置方式，二选一即可：
#
#   1) Windows 用户环境变量（本项目原有约定）
#      根目录的 Python 验证脚本会提示“请在 Windows 环境变量中配置 X”，
#      Next.js 也能直接读取进程环境变量。
#
#   2) web/.env.local（推荐用于本地开发）
#      复制本文件为 web/.env.local 后填入真实值。
#      注意：Next.js 只加载项目目录（web/）下的 .env* 文件，
#      不会向父目录查找，因此放在仓库根目录的 .env.local 不会生效。
#      （已在 Next 16.3.5 上实测：项目目录为 web/ 时 loadedEnvFiles 为空）
#
# 所有变量都不得提交真实值。web/.gitignore 忽略 .env*，
# 并通过 !.env.example 例外保留本文件。
# ============================================================


# ---------- Supabase 服务端（必填） ----------
# 服务端 API 路由使用 service role key 直连数据库（绕过 RLS）。
# 请勿把它写入任何 NEXT_PUBLIC_ 变量，否则会泄露到浏览器。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------- Supabase 浏览器端（见下方二选一） ----------
# 浏览器端需要拿到 URL 和 anon key，有两种来源：
#   A. 下面两个 NEXT_PUBLIC_ 变量：会被打包进前端代码，优先级更高；
#   B. 服务端页面（web/src/app/*/page.tsx）把 SUPABASE_URL /
#      SUPABASE_ANON_KEY 作为 props 传给客户端组件兜底。
# 因此只配 B 也能跑通；两者都缺失时页面会显示“登录服务尚未配置”。
# NEXT_PUBLIC_ 前缀的变量会暴露给浏览器，只能放公开信息。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ⚠️ 这两个变量优先级最高，一旦在 web/.env.local 里指向本地栈
#    （http://127.0.0.1:54321），浏览器就会连本地那个空库：登录会提示
#    账号或密码错误，家属端也看不到任何记忆，而真实数据仍在远端项目里。
#    且 Next 不会热重载 .env 文件，切换后必须重启 dev server。

# 服务端页面读取的兜底 anon key（方式 B）。
# NEXT_PUBLIC_SUPABASE_ANON_KEY 缺失时，web/src/app/*/page.tsx 回退到它。
SUPABASE_ANON_KEY=your-supabase-anon-key


# ---------- SiliconFlow 向量化（必填） ----------
# 使用 BAAI/bge-m3 生成 1024 维 embedding。
# 被 /api/chat、/api/memory、/api/report 共同依赖。
SILICONFLOW_API_KEY=your-siliconflow-api-key


# ---------- Qwen 对话生成（必填） ----------
# 被 /api/chat 依赖，用于意图识别、记忆提取、温和回复生成。
QWEN_API_KEY=your-qwen-api-key
# 兼容 OpenAI 协议的 base url，服务端会拼接 /chat/completions。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选。不设置时默认 qwen-plus。
QWEN_MODEL=qwen-plus


# ---------- DeepSeek 结构化提取与日报建议（必填） ----------
# 被 /api/memory（记忆元数据提取）和 /api/report（日报建议）依赖。
DEEPSEEK_API_KEY=your-deepseek-api-key


# ---------- 可选开关 ----------
# 设为 true 时 /api/chat 只生成回复，不写入数据库，便于端到端联调。
#
# ⚠️ 开启后会静默关闭记忆功能，联调结束务必删除本变量或置为 false：
#   - 长辈自述不会存成记忆（storeStoryMemory 被跳过），
#     追问刚讲过的事时 AI 只能召回旧记忆，表现为"记忆失效"；
#   - 对话不会写入 conversations，家属端日报永远是空的。
TEST_MODE=false
